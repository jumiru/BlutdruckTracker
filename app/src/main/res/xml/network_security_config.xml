<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Lokale Netzwerke (NAS zu Hause) dürfen HTTP verwenden -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Klarnamen (lokale Hostnamen) -->
        <domain includeSubdomains="false">BitScrambler</domain>
        <domain includeSubdomains="false">diskstation</domain>
        <domain includeSubdomains="false">nas</domain>
        <domain includeSubdomains="false">qnap</domain>
        <!-- .local mDNS-Namen (z.B. diskstation.local) -->
        <domain includeSubdomains="true">local</domain>
        <!-- Fritzbox / Telekom: 192.168.178.x -->
        <domain includeSubdomains="true">192.168.178.0</domain>
        <!-- Typische Router-Standardbereiche -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <!-- Business / VPN-Netzwerke -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.1.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
    </domain-config>
    <!-- Alle anderen Verbindungen bleiben sicher (kein HTTP) -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>


